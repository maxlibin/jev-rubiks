# Copy to .env or .env.local (both git-ignored). Read by the Vite dev server and Node scripts only.
TYPESAFE_API_KEY=

# Set this if the dev server logs `getaddrinfo ENOTFOUND api.typesafe.ai`: the proxy
# then resolves TypeSafe through these DNS servers instead of the system resolver.
TYPESAFE_DNS_SERVERS=1.1.1.1,8.8.8.8
